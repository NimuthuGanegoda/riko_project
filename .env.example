# Copy this file to .env and fill in real values. See docs/DEPLOYMENT.md
# for the full deployment walkthrough.
#
# Note: there's no python-dotenv anywhere in this repo, so .env is NOT
# auto-loaded by a bare `python api.py` / run_web.sh. It's consumed by
# docker-compose.yml's `env_file:` directive. For non-Docker use, export
# these vars directly (e.g. `export $(grep -v '^#' .env | xargs)`).

# --- Backend (FastAPI) ---

# Bind address. 127.0.0.1 (default) = loopback only. Set to 0.0.0.0 to
# accept connections from outside the machine -- required when running
# behind Caddy/Docker. docker-compose.yml already sets this for you.
RIKO_HOST=0.0.0.0

# Comma-separated CORS origins. Only matters for cross-origin setups; the
# recommended same-origin Caddy deployment (client + API on one domain)
# doesn't need this in production.
RIKO_ALLOWED_ORIGINS=https://riko.example.com

# Shared-secret header required on every request once set (X-Api-Key).
# Strongly recommended for anything reachable from the public internet.
# Generate with: openssl rand -hex 32
RIKO_API_KEY=

# URL of the GPT-SoVITS TTS inference server. GPT-SoVITS is NOT part of
# this repo and is not deployed by the Dockerfile/docker-compose.yml here --
# run it separately and point this at wherever it's reachable from the
# backend. Default matches the historical hardcoded value (same machine, no
# Docker). If the backend runs in Docker, see docs/DEPLOYMENT.md for the
# networking options (host networking vs. host.docker.internal).
SOVITS_URL=http://127.0.0.1:9880/tts

# --- Client (Vite, build-time only -- not read by docker-compose.yml) ---

# Base URL the built client uses for API calls. Leave unset/empty for the
# recommended same-origin deployment (client + API served from one domain
# via Caddy). client/.env.development already sets this for `npm run dev`.
VITE_API_BASE=
